{
  "manifest_version": 3,
  "name": "FreshPass - 密码生成器",
  "version": "1.0.1",
  "description": "本地优先的密码生成器：打开即生成、自动刷新、规则可定制，复制才记录，不上传不追踪。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "FreshPass 密码生成器",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
